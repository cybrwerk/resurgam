# Manifest §5.3: reverse proxy as a container, fronting both the built
# UI and the API on one origin -- same-origin means the frontend needs
# no CORS config at all (see VITE_API_BASE_URL="/api/v1" in Dockerfile).
#
# Defaults to a self-signed cert ("tls internal") so this works out of
# the box on a private/internal appliance network with no public DNS --
# raised directly by the user's own framing of RESURGAM as something an
# admin reaches without needing direct PBS/PVE network access, the same
# reasoning applies to reaching RESURGAM itself. For a real public
# deployment with a real domain: set RESURGAM_DOMAIN and delete the
# "tls internal" line below to let Caddy provision a real Let's Encrypt
# certificate automatically instead.
#
# default_sni: browsers send no SNI at all when RESURGAM_DOMAIN is a bare
# IP, and Caddy's fallback (match the address the connection arrived on)
# sees this container's own Docker-network IP, not the appliance's --
# so without this, a bare-IP deployment fails every TLS handshake.
{
	default_sni {$RESURGAM_DOMAIN:localhost}
}

{$RESURGAM_DOMAIN:localhost} {
	tls internal

	encode gzip

	# Safe hardening headers for UI and API alike. `?` = only when the
	# response does not set the header itself (e.g. the API's stricter
	# headers on /api/v1/branding/logo win). No script Content-Security-Policy
	# here: it would need verifying against every page of the built app.
	# One directive per header: a combined block would only set any of them
	# when none is present.
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?X-Frame-Options DENY

	handle /api/* {
		reverse_proxy backend:8001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Every other hostname. Without this block Caddy answers a request whose Host
# matches no site with an empty 200 -- found when the 0.3.0 image was opened
# through a port forward (2026-11-21): a blank page and no hint why. The TLS
# handshake still uses the RESURGAM_DOMAIN certificate (default_sni above), so
# the browser shows its usual warning first and then this explanation.
# Deliberately no redirect to RESURGAM_DOMAIN: behind a port forward or proxy
# that address is often not reachable from the client. The request's Host is
# never echoed back (it is client-controlled and would go out unescaped).
https:// {
	tls internal

	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options DENY

	handle /api/* {
		header Content-Type application/json
		respond `{"code":"unknown_host","message":"This RESURGAM appliance only answers on {$RESURGAM_DOMAIN:localhost}, not on the address this request used. Use https://{$RESURGAM_DOMAIN:localhost}/, or set RESURGAM_DOMAIN in /opt/resurgam/appliance/.env to the name or IP you use and run 'docker compose up -d' there.","details":null}` 421
	}

	handle {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
			<title>RESURGAM: wrong address</title>
			<style>body{font-family:system-ui,sans-serif;max-width:40rem;margin:4rem auto;padding:0 1rem;line-height:1.5;color:#1d2a2e}code{background:#eef2f3;padding:.1rem .3rem;border-radius:3px}a{color:#0b5d6b}</style>
			</head><body>
			<h1>This RESURGAM appliance answers on another address</h1>
			<p>The address you opened is not the one this appliance is configured for: <code>{$RESURGAM_DOMAIN:localhost}</code>.</p>
			<p><a href="https://{$RESURGAM_DOMAIN:localhost}/">Open https://{$RESURGAM_DOMAIN:localhost}/</a></p>
			<p>To use the address you opened instead: on the appliance, set <code>RESURGAM_DOMAIN</code> to that name or IP in <code>/opt/resurgam/appliance/.env</code> and run <code>docker compose up -d</code> in that folder. Details: <code>appliance/DEPLOY.md</code>.</p>
			</body></html>
			HTML 421
	}
}

# Plain HTTP for any other hostname: on to HTTPS, where the page above explains.
http:// {
	redir https://{host}{uri}
}
