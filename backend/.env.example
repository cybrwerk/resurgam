# Copy to .env for local development. Never commit a real .env file.

# Lets the app boot with the class-level defaults below (empty secrets,
# the hardcoded dev database password) -- see config.py's
# _validate_not_dev_defaults. Any deployment that is NOT local development
# must leave this unset/false and configure real values instead.
DEV_MODE=true

DATABASE_URL=postgresql+psycopg://resurgam:resurgam-dev-only@localhost:55432/resurgam

# Break-glass local login (manifest §6.3) — disabled by default.
# Generate a hash with:
#   uv run python -c "import bcrypt; print(bcrypt.hashpw(b'change-me', bcrypt.gensalt()).decode())"
BREAKGLASS_ENABLED=false
BREAKGLASS_USERNAME=admin
BREAKGLASS_PASSWORD_HASH=

# Symmetric secret signing break-glass session tokens. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Fernet key for the interim local secrets provider (docs/adr/0005) — used
# to encrypt PBS/PVE API tokens at rest. Not a substitute for a real
# secrets provider (OpenBao); see the ADR. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_LOCAL_ENCRYPTION_KEY=

# Real OIDC (manifest §6.3, ADR 0007) — first target: authentik. Create an
# OAuth2/OpenID Provider + Application in authentik with redirect URI
# matching OIDC_REDIRECT_URI below (Authorization Code flow, confidential
# client, scopes: openid, email, profile, groups). Grant RESURGAM roles by
# putting the authentik user in a group named resurgam-<role-key>, e.g.
# resurgam-platform-admin or resurgam-viewer (hyphens and underscores both
# work; always granted at global scope).
OIDC_ISSUER=http://localhost:9000/application/o/<slug>/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback

# Frontend (Milestone 2, ADR 0008). FRONTEND_ORIGIN is used for CORS;
# FRONTEND_SUCCESS_URL is where the OIDC callback redirects the browser
# after a successful login, with the session token in a URL fragment.
# Defaults already match the Vite dev server — override only if it runs
# somewhere else.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_SUCCESS_URL=http://localhost:5173/auth/callback
