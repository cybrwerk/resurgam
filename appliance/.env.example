# Copy to .env and fill in real values before `docker compose up -d`.
# Required values have no default and docker-compose will refuse to
# start without them (see the ${VAR:?message} guards in docker-compose.yml).
# The backend also independently refuses to boot on a missing/weak secret
# unless DEV_MODE=true (backend/src/resurgam_api/config.py) -- this
# compose file never sets it, so that protection stays on.

# --- Release -------------------------------------------------------------
# The release version the stack runs: picks the resurgam-backend/-web image
# tags. On the appliance, first-boot.sh and the updater (resurgam-update)
# manage it. For a local build, keep it equal to ../VERSION.
RESURGAM_VERSION=0.2.0

# --- Database -----------------------------------------------------------
POSTGRES_USER=resurgam
POSTGRES_PASSWORD=
POSTGRES_DB=resurgam

# --- Core secrets ---------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (run from backend/, or any Python environment with the `cryptography` package installed)
SECRETS_LOCAL_ENCRYPTION_KEY=

# --- First admin access ---------------------------------------------------
# The first-boot setup wizard (shown automatically on first launch) is the
# normal way to create the first admin account. Breakglass is the
# emergency fallback (docs/adr/0004) -- disable it (set to false) once a
# real admin account exists, or at least set a real, unique password hash
# below rather than leaving the wizard as the only gate.
BREAKGLASS_ENABLED=true
BREAKGLASS_USERNAME=admin
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'CHANGE-ME', bcrypt.gensalt()).decode())"
BREAKGLASS_PASSWORD_HASH=

# --- Networking -------------------------------------------------------
# The hostname this appliance is reached at -- used for TLS, CORS,
# WebAuthn's relying-party origin, and the Recovery Lab probe-appliance
# callback URL. A real, resolvable hostname if you're not just testing
# locally (WebAuthn in particular will refuse to work against a bare IP).
RESURGAM_DOMAIN=localhost

# --- OIDC SSO (optional) ---------------------------------------------------
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
