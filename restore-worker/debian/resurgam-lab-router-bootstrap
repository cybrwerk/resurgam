#!/bin/sh
# RESURGAM Recovery Lab probe appliance: router/DHCP/firewall bootstrap
# (ADR 0019, Phase B). Runs once at boot (systemd oneshot,
# resurgam-lab-router.service) after cloud-init has written
# /etc/default/resurgam-lab-router with this run's GATEWAY_IP/
# SUBNET_CIDR/DNS_IP/DHCP_RANGE_START/DHCP_RANGE_END.
#
# Deliberate design (direct user correction, 2026-09-21): PVE itself
# never provisions a subnet/gateway/DHCP/SNAT on the isolated Lab VNet
# -- this appliance VM is the sole owner of that segment's L3/DHCP/
# firewall/NAT, entirely self-contained inside this guest. The PVE host
# stays a pure L2 bridge for net0, never part of the lab's data path.
#
# NOT YET LIVE-VERIFIED against a real booted appliance (written
# 2026-09-22, no live infrastructure run yet) -- in particular the
# interface-discovery-by-IP approach below (rather than assuming a fixed
# guest interface name) is a deliberate hedge against PVE's `net0`
# config-slot label not being the guest's own predictable interface
# name, but needs confirming against a real boot.
set -eu

CONFIG_FILE=/etc/default/resurgam-lab-router
if [ ! -f "$CONFIG_FILE" ]; then
    echo "resurgam-lab-router-bootstrap: $CONFIG_FILE not found (cloud-init snippet not applied?)" >&2
    exit 1
fi
# shellcheck disable=SC1090
. "$CONFIG_FILE"

if [ -z "${GATEWAY_IP:-}" ] || [ -z "${SUBNET_CIDR:-}" ]; then
    echo "resurgam-lab-router-bootstrap: GATEWAY_IP/SUBNET_CIDR not set, nothing to do" >&2
    exit 0
fi

# Find the interface cloud-init assigned GATEWAY_IP to (net0, statically
# configured -- see backend's execute_restore_test_plan) rather than
# assuming a fixed guest interface name, which PVE's own "net0" config
# slot label does not guarantee (predictable naming, e.g. enp0s18).
NET0_IFACE=$(ip -4 -o addr show | awk -v ip="$GATEWAY_IP" '$4 ~ "^" ip "/" {print $2; exit}')
if [ -z "$NET0_IFACE" ]; then
    echo "resurgam-lab-router-bootstrap: no interface found with address $GATEWAY_IP" >&2
    exit 1
fi

# The uplink NIC (net1, DHCP-assigned by the operator's own LAN) is
# whichever other real interface exists.
NET1_IFACE=$(ip -4 -o link show | awk -F': ' '{print $2}' | grep -v -E '^(lo|'"$NET0_IFACE"')$' | head -n1)
if [ -z "$NET1_IFACE" ]; then
    echo "resurgam-lab-router-bootstrap: no uplink interface found besides $NET0_IFACE" >&2
    exit 1
fi

# Record the resolved interface name for resurgam-lab-prober's own
# EnvironmentFile= (it loads this same file) -- idempotent, replaces any
# prior line from an earlier boot of the same appliance.
sed -i '/^RESURGAM_LAB_PROBER_NET0_INTERFACE=/d' "$CONFIG_FILE"
echo "RESURGAM_LAB_PROBER_NET0_INTERFACE=$NET0_IFACE" >> "$CONFIG_FILE"

DNS_FOR_DHCP="${DNS_IP:-$GATEWAY_IP}"

mkdir -p /etc/dnsmasq.d
{
    echo "# Generated by resurgam-lab-router-bootstrap -- do not edit by hand."
    echo "interface=$NET0_IFACE"
    echo "bind-interfaces"
    echo "dhcp-option=option:router,$GATEWAY_IP"
    echo "dhcp-option=option:dns-server,$DNS_FOR_DHCP"
    if [ -n "${DHCP_RANGE_START:-}" ] && [ -n "${DHCP_RANGE_END:-}" ]; then
        echo "dhcp-range=$DHCP_RANGE_START,$DHCP_RANGE_END,12h"
    fi
} > /etc/dnsmasq.d/resurgam-lab-router.conf
systemctl restart dnsmasq

# Forwarding + SNAT/masquerade from the isolated net0 segment out net1 --
# the firewall/NAT boundary lives entirely in this VM, never on the PVE
# host (see module docstring above).
sysctl -w net.ipv4.ip_forward=1 >/dev/null
mkdir -p /etc/sysctl.d
echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-resurgam-lab-router.conf

nft add table inet resurgam_lab_router 2>/dev/null || true
nft flush table inet resurgam_lab_router
nft add chain inet resurgam_lab_router forward "{ type filter hook forward priority 0 ; policy drop ; }"
nft add rule inet resurgam_lab_router forward iifname "$NET0_IFACE" oifname "$NET1_IFACE" accept
nft add rule inet resurgam_lab_router forward iifname "$NET1_IFACE" oifname "$NET0_IFACE" ct state established,related accept
nft add chain inet resurgam_lab_router postrouting "{ type nat hook postrouting priority 100 ; }"
nft add rule inet resurgam_lab_router postrouting oifname "$NET1_IFACE" masquerade

echo "resurgam-lab-router-bootstrap: net0=$NET0_IFACE net1=$NET1_IFACE gateway=$GATEWAY_IP"
